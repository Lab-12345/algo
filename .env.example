# TradePilot Secrets and Environment Variables
# Copy this file to .env and configure with your credentials.
# NEVER commit the actual .env file to Git!

# --- Application Server ---
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_at_least_32_chars
JWT_EXPIRY=24h

# --- Database ---
MONGODB_URI=mongodb://localhost:27017/tradepilot
# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/tradepilot?retryWrites=true&w=majority

# --- Trading Mode (Default MUST be PAPER for safety) ---
DEFAULT_TRADING_MODE=PAPER
ALLOW_LIVE_TRADING=false

# --- Angel One SmartAPI Credentials ---
# Required for real broker authentication & WebSocket
SMARTAPI_API_KEY=your_smartapi_api_key_here
SMARTAPI_CLIENT_CODE=your_angel_one_client_id
SMARTAPI_PASSWORD=your_angel_one_password_or_pin
SMARTAPI_TOTP_KEY=your_angel_one_totp_secret_key
SMARTAPI_FEED_TOKEN=

# --- Server IP Egress Verification ---
# On AWS Lightsail VPS, this should match your attached static IPv4
REGISTERED_STATIC_IP=127.0.0.1
ENFORCE_STATIC_IP_CHECK=false

# --- Risk Ceiling Guards ---
MAX_DAILY_LOSS=2000
MAX_RISK_PER_TRADE=500
MAX_OPEN_POSITIONS=2
MAX_LOTS_PER_ORDER=2

# --- Trading Worker Configuration ---
WORKER_HEARTBEAT_INTERVAL_MS=5000
WORKER_RECONNECT_MAX_RETRIES=10
CANDLE_TIMEFRAME_PRIMARY=5m
CANDLE_TIMEFRAME_TREND=15m
